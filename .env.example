# Offline scene: no environment file is needed.
# Optional compatible API backend; configure only in your ignored local .env.
# Leave the API fields blank to start unconfigured. The MIND panel can then add an
# OpenAI-compatible API or invite another agent. Those choices stay in adapter memory
# until disconnect or restart and are not written back into this file.
AGENT_NAME=Agent
API_BASE_URL=
API_AUTH_MODE=api-key
API_KEY=
API_TEXT_MODEL=
API_VISION_MODEL=
API_CREATIVE_MODEL=

# Optional exact scene origins allowed through the same-origin development proxy.
# For Tailscale, set the URL you open (scheme, hostname/IP and port), then restart api.
# Comma-separated; blank keeps the localhost defaults. No wildcards or URL paths.
API_ALLOWED_ORIGINS=

# Optional generic authorization-code + PKCE connection (API_AUTH_MODE=oauth).
# Register this redirect URI: http://127.0.0.1:18081/auth/callback
# Tokens remain in backend memory; restart requires sign-in again.
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=

# Learned memory (issue #39). While the AI mind is on, conversations are saved by
# this adapter and recalled in later sessions. This is separate from the JSON Brain.
# Every /memory route needs a bearer token. Leave blank to have the adapter create a
# random one in MEMORY_DIR/api-token (owner-only file). Browsers on this computer get
# it automatically through the scene proxy; remote scenes (LAN, Tailscale, tunnels)
# enter it once in Settings > Mind > Memory token. Set it here, never in chat.
MEMORY_API_TOKEN=
# Local store directory (default saved-world/memory, which git ignores).
MEMORY_DIR=
# Optional Turso cloud store. Set both to use Turso; leave both blank for local files.
# Get them with: turso db show --url <db> and turso db tokens create <db>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
