{
  "name": "cyberdyne-t800-agent-embodiment-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --port 5340",
    "test:browser": "playwright test",
    "brain": "node --env-file-if-exists=.env tools/api-server.mjs",
    "api": "node --env-file-if-exists=.env tools/api-server.mjs",
    "brain:validate": "node tools/validate-brain.mjs",
    "test": "node --test test/*.test.mjs",
    "privacy:check": "node tools/privacy-check.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "7.3.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A service-neutral embodied T-800 agent scene with vision, physical actions and a customizable JSON memory architecture."
}
